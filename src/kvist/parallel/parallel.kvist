(package parallel)
(import chan "core:sync/chan")
(import os "core:os")
(import thread "core:thread")

(odin "parallel_Task :: struct($T: typeid) {
    result: chan.Chan(T),
    thread: ^thread.Thread,
    data: rawptr,
}")

(defn- result-impl
  [task: (parallel_Task $T)] -> T #force_inline
  (let [[value ok] (chan.recv task.result)]
    (thread.join task.thread)
    (thread.destroy task.thread)
    (free task.data)
    (chan.destroy task.result)
    (assert ok "parallel task ended without a result")
    value))

(defn- worker-count-impl
  [requested-worker-count: int, source-count: int] -> int #force_inline
  (let [worker-count requested-worker-count]
    (when (<= worker-count 0)
      (set! worker-count (- (os.get_processor_core_count) 1))
      (when (> worker-count 16)
        (set! worker-count 16)))
    (when (> worker-count source-count)
      (set! worker-count source-count))
    (when (< worker-count 1)
      (set! worker-count 1))
    worker-count))

(defn- map-worker
  [f: (fn [x: $T] -> $U), xs: []T, out: (ptr (dynamic U)), start: int, step: int] -> bool
  (let [i start]
    (while (< i (count xs))
      (set! (deref out)[i] (f xs[i]))
      (set! i (+ i step)))
    true))

(defn- map-impl
  [f: (fn [x: $T] -> $U), xs: []T, requested-worker-count: int] -> [dynamic]U #force_inline
  (let [out (make [dynamic]U (count xs))]
    (when (= (count xs) 0)
      (return out))
    (let [worker-count (worker-count-impl requested-worker-count (count xs))
          tasks (make (dynamic (parallel_Task bool)) 0 worker-count) :defer
          i 0]
      (while (< i worker-count)
        (append (addr tasks) (thread-start parallel_Task map-worker f xs (addr out) i worker-count))
        (set! i (+ i 1)))
      (set! i 0)
      (while (< i (count tasks))
        (discard (result-impl tasks[i]))
        (set! i (+ i 1))))
    out))

(defn- for-worker
  [f: (fn [x: $T]), xs: []T, start: int, step: int] -> bool
  (let [i start]
    (while (< i (count xs))
      (f xs[i])
      (set! i (+ i step)))
    true))

(defn- for-impl
  [f: (fn [x: $T]), xs: []T, requested-worker-count: int] #force_inline
  (when (= (count xs) 0)
    (return))
  (let [worker-count (worker-count-impl requested-worker-count (count xs))
        tasks (make (dynamic (parallel_Task bool)) 0 worker-count) :defer
        i 0]
    (while (< i worker-count)
      (append (addr tasks) (thread-start parallel_Task for-worker f xs i worker-count))
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i (count tasks))
      (discard (result-impl tasks[i]))
      (set! i (+ i 1)))))

(defmacro- map-form
  [worker xs worker-count]
  `(map-impl ~worker ~xs ~worker-count))

(defmacro- for-form
  [worker xs worker-count]
  `(for-impl ~worker ~xs ~worker-count))

(defmacro start
  "Start `(worker args...)` on another OS thread and return a task handle.

  This is compiler-specialized for known worker functions or inline `fn`
  literals. The generated Odin uses `core:thread` for execution and a one-value
  `core:sync/chan` channel for result transport."
  [worker & args]
  `(thread-start parallel_Task ~worker ~@args))

(defmacro result
  "Block until a task started by `parallel.start` finishes, clean up its
  thread/channel/task-data resources, and return the worker result."
  [task]
  `(result-impl ~task))

(defmacro detach
  "Start `(worker args...)` on another OS thread without returning a task handle.

  Detached workers may be known named functions or inline `fn` literals. They
  are for fire-and-forget side effects and must not return a value. The
  generated thread is self-cleaning and frees its task data after the worker
  returns."
  [worker & args]
  `(thread-detach ~worker ~@args))

(defmacro map
  "Apply a named or inline one-argument `worker` to every item in `xs` using a
  bounded set of OS threads, preserve input order, and return an owned dynamic
  array."
  [worker xs]
  (map-form worker xs 0))

(defmacro map-with
  "Like `map`, but accepts `{workers: n}` to control the worker count."
  [options worker xs]
  (if (brace? options)
    (if (= (count options) 0)
        (error "parallel.map-with expects {workers: n}")
      (if (= (count options) 2)
        (if (= (name (first options)) "workers")
          (map-form worker xs (nth options 1))
          (error (str "parallel.map-with unknown option: " (name (first options)))))
        (error "parallel.map-with expects option key/value pairs")))
    (error "parallel.map-with expects options like {workers: n}")))

(defmacro for
  "Apply a named or inline one-argument side-effecting `worker` to every item in
  `xs` using a bounded set of OS threads."
  [worker xs]
  (for-form worker xs 0))

(defmacro for-with
  "Like `for`, but accepts `{workers: n}` to control the worker count."
  [options worker xs]
  (if (brace? options)
    (if (= (count options) 0)
        (error "parallel.for-with expects {workers: n}")
      (if (= (count options) 2)
        (if (= (name (first options)) "workers")
          (for-form worker xs (nth options 1))
          (error (str "parallel.for-with unknown option: " (name (first options)))))
        (error "parallel.for-with expects option key/value pairs")))
    (error "parallel.for-with expects options like {workers: n}")))
