(package data)
(import core "kvist:core")
(import arr "kvist:arr")

(defstruct Decode-Error {
  path: Data
  expected: Data-Kind
  actual: Data-Kind
  enum-value?: bool
  expected-type: string
  actual-value: Data
})

(defn decode-error
  [path: Data, expected: Data-Kind, actual: Data-Kind] -> Decode-Error
  (Decode-Error {path: path expected: expected actual: actual}))

(defn- decode-enum-error
  [path: Data, expected-type: string, actual-value: Data] -> Decode-Error
  (Decode-Error {
    path: path
    expected: .Keyword
    actual: (kind actual-value)
    enum-value?: true
    expected-type: expected-type
    actual-value: actual-value
  }))

(defmacro decode
  "Decode Data into a native value selected by type.

  `(decode Person value)` and `(decode (dynamic i64) value)` return
  `[decoded err ok]`. An optional third argument supplies the Data path used
  as the root of path-aware errors."
  [target-type value & rest]
  (if (= (count rest) 0)
    `(decode-data ~target-type ~value)
    (if (= (count rest) 1)
      `(decode-data ~target-type ~value ~(first rest))
      (error "data.decode expects type, value, and optional path"))))

(defmacro validate
  "Validate Data against the shape selected by a native type without decoding.

  `(validate Person value)` returns `[err ok]`. An optional third argument
  supplies the Data path used as the root of path-aware errors."
  [target-type value & rest]
  (if (= (count rest) 0)
    `(validate-data ~target-type ~value)
    (if (= (count rest) 1)
      `(validate-data ~target-type ~value ~(first rest))
      (error "data.validate expects type, value, and optional path"))))

(defn from-nil
  "Construct nil Data."
  [] -> Data #owned #force_inline
  (odin-call "kvist_data_make_nil"))

(defn from-bool
  "Construct boolean Data."
  [value: bool] -> Data #owned #force_inline
  (odin-call "kvist_data_make_bool" value))

(defn from-int
  "Construct integer Data."
  [value: i64] -> Data #owned #force_inline
  (odin-call "kvist_data_make_int" value))

(defn from-float
  "Construct floating-point Data."
  [value: f64] -> Data #owned #force_inline
  (odin-call "kvist_data_make_float" value))

(defn from-string
  "Construct string Data with owned immutable text."
  [value: string] -> Data #owned #force_inline
  (odin-call "kvist_data_make_text" .String value))

(defn from-symbol
  "Construct symbol Data with owned immutable text."
  [value: string] -> Data #owned #force_inline
  (odin-call "kvist_data_make_text" .Symbol value))

(defn from-keyword
  "Construct keyword Data with owned immutable text."
  [value: string] -> Data #owned #force_inline
  (odin-call "kvist_data_make_text" .Keyword value))

(defn list-from-array
  "Construct list Data from a native array, retaining each element."
  [values: []Data] -> Data #owned #force_inline
  (odin-call "kvist_data_make_items" .List values))

(defn vector-from-array
  "Construct vector Data from a native array, retaining each element."
  [values: []Data] -> Data #owned #force_inline
  (odin-call "kvist_data_make_items" .Vector values))

(defn set-from-array
  "Construct set Data from a native array, retaining each distinct element."
  [values: []Data] -> Data #owned #force_inline
  (odin-call "kvist_data_make_items" .Set values))

(defn map-from-alternating
  "Construct map Data from an alternating native array of keys and values."
  [values: []Data] -> Data #owned #force_inline
  (odin-call "kvist_data_make_map" values))

(defn empty-map
  "Construct empty map Data."
  [] -> Data #owned #force_inline
  (odin-call "kvist_data_empty_map"))

(defn tagged
  "Construct tagged Data, retaining `value` and owning a copy of `tag`.

  The tag excludes EDN's leading `#`; for example, use `\"uuid\"`."
  [tag: string, value: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_make_tagged" tag value))

(defn retain
  "Return an owned reference to `value` for storage outside managed bindings."
  [value: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_retain" value))

(defn append-retained!
  "Append `value` to a native dynamic Data array and retain it for the array.

  Release every appended element with `release` before deleting the array."
  [values: ^[dynamic]Data, value: Data] #force_inline
  (odin-call "kvist_data_append_retained" values value))

(defn release
  "Release a Data reference retained for native storage."
  [value: Data] #force_inline
  (odin-call "kvist_data_release" value))

(defn delete-owned-array!
  "Release every element in an owned native Data array and delete its storage.

  Use this only with arrays whose contract says that each element is retained
  for the array."
  [values: [dynamic]Data]
  (for [value values]
    (release value))
  (delete values))

(defn- freeze-items!
  "Transfer a retained native item buffer into one immutable Data node."
  [kind: Data-Kind, values: ^[dynamic]Data] -> Data #owned #force_inline
  (odin-call "kvist_data_freeze_items" kind values))

(defn- freeze-map!
  "Transfer retained alternating key/value Data into one immutable map node."
  [values: ^[dynamic]Data] -> Data #owned #force_inline
  (odin-call "kvist_data_freeze_map" values))

(defn assoc
  "Return immutable map or vector Data with `key` associated to `value`."
  [collection: Data, key: Data, value: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_assoc" collection key value))

(defn dissoc
  "Return immutable map Data without `key`."
  [collection: Data, key: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_dissoc" collection key))

(defn dissoc-in
  "Remove the leaf association at `path` from nested map Data.

  `path` is list or vector Data. Empty parent maps are preserved and a missing
  path leaves `collection` unchanged."
  [collection: Data, path: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_dissoc_in" collection path))

(defn conj
  "Return immutable sequential or set Data with `value` added."
  [collection: Data, value: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_conj" collection value))

(defn append
  "Return list, vector, or set Data with `value` added at the end."
  [collection: Data, value: Data] -> Data #owned #force_inline
  (odin-call "kvist_data_append" collection value))

(defn- append-pair-retained!
  [values: ^[dynamic]Data, key: Data, value: Data]
  (append-retained! values key)
  (append-retained! values value))

(defn merge
  "Return map Data containing entries from `left` and `right`.

  Values from `right` replace equal keys from `left`."
  [left: Data, right: Data] -> Data
  (if (not (and (map-like? left) (map-like? right)))
    (panic "data.merge expects map or nil Data"))
  (let [out (arr.empty Data (* 2 (+ (core.count left) (core.count right))))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count left))]
      (append-pair-retained!
       (addr out) (key-at left index) (value-at left index)))
    (for [index (arr.range 0 (core.count right))]
      (append-pair-retained!
       (addr out) (key-at right index) (value-at right index)))
    (freeze-map! (addr out))))

(defn int
  "Read the integer payload of `value`.

  The value must be integer Data. This returns the native `i64` payload and
  does not allocate."
  [value: Data] -> i64 #force_inline
  (odin-call "kvist_data_int" value))

(defn float
  "Read the floating-point payload of `value`."
  [value: Data] -> f64 #force_inline
  (odin-call "kvist_data_float" value))

(defn bool
  "Read the boolean payload of `value`."
  [value: Data] -> bool #force_inline
  (odin-call "kvist_data_bool" value))

(defn string
  "Read the borrowed native string payload of string Data."
  [value: Data] -> string #borrowed #force_inline
  (odin-call "kvist_data_string" value))

(defn symbol
  "Read the borrowed native text of symbol Data."
  [value: Data] -> string #borrowed #force_inline
  (odin-call "kvist_data_symbol" value))

(defn keyword
  "Read the borrowed native text of keyword Data."
  [value: Data] -> string #borrowed #force_inline
  (odin-call "kvist_data_keyword" value))

(defn text
  "Read borrowed native text from string, symbol, or keyword Data."
  [value: Data] -> string #borrowed #force_inline
  (odin-call "kvist_data_text" value))

(defn tag
  "Read the borrowed tag text from tagged Data, without the leading `#`."
  [value: Data] -> string #borrowed #force_inline
  (odin-call "kvist_data_tag" value))

(defn tagged-value
  "Read the borrowed payload from tagged Data."
  [value: Data] -> Data #borrowed #force_inline
  (odin-call "kvist_data_tagged_value" value))

(defn kind
  "Return the runtime kind of `value`."
  [value: Data] -> Data-Kind #force_inline
  (odin-call "kvist_data_kind" value))

(defn kind-keyword
  "Return the runtime kind as Clojure-familiar keyword Data."
  [value: Data] -> Data
  (case (kind value)
    .Nil ':nil
    .Bool ':bool
    .Int ':int
    .Float ':float
    .String ':string
    .Symbol ':symbol
    .Keyword ':keyword
    .List ':list
    .Vector ':vector
    .Map ':map
    .Set ':set
    .Tagged ':tagged
    ':unknown))

(defn describe
  "Return a shallow, immutable Data description suitable for inspection.

  Every result contains `:kind`. Collections and strings include `:count`,
  maps include `:keys`, and tagged values include their textual `:tag`.
  The description intentionally exposes no backing-node or reference-count
  details."
  [value: Data] -> Data
  (let [result: Data {:kind (kind-keyword value)}]
    (if (or (string? value)
            (list? value)
            (vector? value)
            (map? value)
            (set? value))
      (set! result (assoc result :count (from-int (i64 (count value))))))
    (if (map? value)
      (set! result (assoc result :keys (keys value))))
    (if (tagged? value)
      (set! result (assoc result :tag (from-string (tag value)))))
    result))

(defn equal?
  "Return structural Data equality without allocating."
  [left: Data, right: Data] -> bool #force_inline
  (odin-call "kvist_data_equal" left right))

(defn decode-int-at
  "Decode integer Data to `i64`.

  `path` identifies the value in the surrounding input and is retained in the
  returned error. The zero `Decode-Error` and true boolean indicate success."
  [value: Data, path: Data] -> [decoded: i64, err: Decode-Error, ok: bool]
  (if (int? value)
    (return (int value) {} true)
    (return 0 (decode-error path .Int (kind value)) false)))

(defn decode-int
  "Decode root integer Data to `i64`."
  [value: Data] -> [decoded: i64, err: Decode-Error, ok: bool]
  (decode-int-at value '[]))

(defn decode-float-at
  "Decode floating-point Data to `f64`, preserving `path` on failure."
  [value: Data, path: Data] -> [decoded: f64, err: Decode-Error, ok: bool]
  (if (float? value)
    (return (float value) {} true)
    (return 0 (decode-error path .Float (kind value)) false)))

(defn decode-float
  "Decode root floating-point Data to `f64`."
  [value: Data] -> [decoded: f64, err: Decode-Error, ok: bool]
  (decode-float-at value '[]))

(defn decode-bool-at
  "Decode boolean Data to `bool`, preserving `path` on failure."
  [value: Data, path: Data] -> [decoded: bool, err: Decode-Error, ok: bool]
  (if (bool? value)
    (return (bool value) {} true)
    (return false (decode-error path .Bool (kind value)) false)))

(defn decode-bool
  "Decode root boolean Data to `bool`."
  [value: Data] -> [decoded: bool, err: Decode-Error, ok: bool]
  (decode-bool-at value '[]))

(defn nil? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_nil_p" value))

(defn bool? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_bool_p" value))

(defn int? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_int_p" value))

(defn float? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_float_p" value))

(defn string? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_string_p" value))

(defn symbol? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_symbol_p" value))

(defn keyword? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_keyword_p" value))

(defn list? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_list_p" value))

(defn vector? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_vector_p" value))

(defn map? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_map_p" value))

(defn set? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_set_p" value))

(defn tagged? [value: Data] -> bool #force_inline
  (odin-call "kvist_data_tagged_p" value))

(defn- sequential?
  [value: Data] -> bool #force_inline
  (or (nil? value) (list? value) (vector? value) (set? value)))

(defn- path?
  [value: Data] -> bool #force_inline
  (or (list? value) (vector? value)))

(defn- map-like?
  [value: Data] -> bool #force_inline
  (or (nil? value) (map? value)))

(defn count
  "Return the number of entries in runtime collection Data.

  Maps count key/value entries; lists, vectors, and sets count items; strings
  count bytes, matching ordinary `count` behavior for Data."
  [value: Data] -> int #force_inline
  (odin-call "kvist_data_count" value))

(defn key-at
  "Return the key at `index` in map Data.

  Map traversal order is the literal/runtime backing order."
  [value: Data, index: int] -> Data #borrowed #force_inline
  (odin-call "kvist_data_key_at" value index))

(defn value-at
  "Return the value at `index` in map Data."
  [value: Data, index: int] -> Data #borrowed #force_inline
  (odin-call "kvist_data_value_at" value index))

(defn nth
  "Return the value at `index` in list or vector Data.

  An out-of-range index returns nil Data, matching ordinary Data lookup."
  [value: Data, index: int] -> Data #borrowed #force_inline
  (core.get value index))

(defn item-at
  "Return the item at `index` in list, vector, or set backing order."
  [value: Data, index: int] -> Data #borrowed #force_inline
  (odin-call "kvist_data_item_at" value index))

(defn- get-in-at
  [value: Data, path: Data, index: int] -> Data #borrowed
  (if (= index (core.count path))
    value
    (let [key (item-at path index)
          child (core.get value key)]
      (get-in-at child path (+ index 1)))))

(defn get-in
  "Follow list or vector Data `path` through nested map, list, and vector Data."
  [value: Data, path: Data] -> Data #borrowed
  (if (not (path? path))
    (panic "data.get-in expects a list or vector Data path"))
  (get-in-at value path 0))

(defn- assoc-in-at
  [collection: Data, path: Data, index: int, value: Data] -> Data
  (let [key (item-at path index)]
    (if (= index (- (core.count path) 1))
      (assoc collection key value)
      (let [child (core.get collection key)]
        (if (nil? child)
          (set! child (empty-map)))
        (assoc collection key (assoc-in-at child path (+ index 1) value))))))

(defn assoc-in
  "Associate `value` at a non-empty list or vector Data path.

  Missing or nil intermediate values become maps."
  [collection: Data, path: Data, value: Data] -> Data
  (if (not (path? path))
    (panic "data.assoc-in expects a list or vector Data path"))
  (if (= (core.count path) 0)
    (panic "data.assoc-in expects a non-empty path"))
  (assoc-in-at collection path 0 value))

(defn update
  "Return `collection` with the value at `key` replaced by `(f old-value)`."
  [collection: Data, key: Data, f: (fn [value: Data] -> Data)] -> Data
  (let [updated (f (core.get collection key))]
    (assoc collection key updated)))

(defn update-in
  "Return `collection` with the value at list or vector Data `path` replaced."
  [collection: Data, path: Data, f: (fn [value: Data] -> Data)] -> Data
  (if (not (path? path))
    (panic "data.update-in expects a list or vector Data path"))
  (if (= (core.count path) 0)
    (panic "data.update-in expects a non-empty path"))
  (let [updated (f (get-in collection path))]
    (assoc-in collection path updated)))

(defn keys
  "Return map keys as owned vector Data in backing-entry order."
  [value: Data] -> Data
  (if (not (map-like? value))
    (panic "data.keys expects map or nil Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (arr.push! out (key-at value index)))
    (let [result (vector-from-array out[:])]
      (delete out)
      result)))

(defn vals
  "Return map values as owned vector Data in backing-entry order."
  [value: Data] -> Data
  (if (not (map-like? value))
    (panic "data.vals expects map or nil Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (arr.push! out (value-at value index)))
    (let [result (vector-from-array out[:])]
      (delete out)
      result)))

(defn to-owned-array
  "Copy sequential Data into a native array that owns every element reference.

  Clean up the result with `delete-owned-array!`."
  [value: Data] -> [dynamic]Data
  (if (not (sequential? value))
    (panic "data.to-owned-array expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (append-retained! (addr out) (item-at value index)))
    out))

(defn keys-owned-array
  "Return a native array that owns one retained reference per map key."
  [value: Data] -> [dynamic]Data
  (if (not (map-like? value))
    (panic "data.keys-owned-array expects map or nil Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (append-retained! (addr out) (key-at value index)))
    out))

(defn vals-owned-array
  "Return a native array that owns one retained reference per map value."
  [value: Data] -> [dynamic]Data
  (if (not (map-like? value))
    (panic "data.vals-owned-array expects map or nil Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (append-retained! (addr out) (value-at value index)))
    out))

(defn vec
  "Convert nil, list, vector, or set Data to owned vector Data."
  [value: Data] -> Data
  (if (not (sequential? value))
    (panic "data.vec expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (arr.push! out (item-at value index)))
    (let [result (vector-from-array out[:])]
      (delete out)
      result)))

(defn list
  "Convert nil, list, vector, or set Data to owned list Data."
  [value: Data] -> Data
  (if (not (sequential? value))
    (panic "data.list expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (arr.push! out (item-at value index)))
    (let [result (list-from-array out[:])]
      (delete out)
      result)))

(defn set
  "Convert nil, list, vector, or set Data to owned set Data."
  [value: Data] -> Data
  (if (not (sequential? value))
    (panic "data.set expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count value))]
    (for [index (arr.range 0 (core.count value))]
      (arr.push! out (item-at value index)))
    (let [result (set-from-array out[:])]
      (delete out)
      result)))

(defn entries
  "Return map entries as owned `[key value]` vectors in an owned vector."
  [value: Data] -> Data
  (if (not (map-like? value))
    (panic "data.entries expects map or nil Data"))
  (let [out (arr.empty Data (core.count value))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count value))]
      (let [pair: [2]Data [(key-at value index) (value-at value index)]
            entry (vector-from-array pair[:])]
        (append-retained! (addr out) entry)))
    (freeze-items! .Vector (addr out))))

(defn first
  "Return the borrowed first sequential item, or nil when absent."
  [collection: Data] -> Data #borrowed
  (if (not (sequential? collection))
    (panic "data.first expects nil, list, vector, or set Data"))
  (if (= (core.count collection) 0)
    'nil
    (item-at collection 0)))

(defn second
  "Return the borrowed second sequential item, or nil when absent."
  [collection: Data] -> Data #borrowed
  (if (not (sequential? collection))
    (panic "data.second expects nil, list, vector, or set Data"))
  (if (< (core.count collection) 2)
    'nil
    (item-at collection 1)))

(defn last
  "Return the borrowed last sequential item, or nil when absent."
  [collection: Data] -> Data #borrowed
  (if (not (sequential? collection))
    (panic "data.last expects nil, list, vector, or set Data"))
  (if (= (core.count collection) 0)
    'nil
    (item-at collection (- (core.count collection) 1))))

(defn- range-vector
  [collection: Data, start: int, end: int] -> Data
  (let [out (arr.empty Data (- end start))]
    (defer (delete-owned-array! out))
    (for [index (arr.range start end)]
      (append-retained! (addr out) (item-at collection index)))
    (freeze-items! .Vector (addr out))))

(defn split-at
  "Split sequential Data at `n` into two owned vectors.

  Negative indexes clamp to zero and indexes past the end clamp to the input
  count."
  [n: int, collection: Data] -> [left: Data, right: Data]
  (if (not (sequential? collection))
    (panic "data.split-at expects nil, list, vector, or set Data"))
  (let [middle n]
    (if (< middle 0)
      (set! middle 0))
    (if (> middle (core.count collection))
      (set! middle (core.count collection)))
    (return
      (range-vector collection 0 middle)
      (range-vector collection middle (core.count collection)))))

(defn partition
  "Return owned vectors of exactly `n` consecutive items.

  A trailing group smaller than `n` is omitted. Non-positive `n` returns an
  empty vector."
  [n: int, collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.partition expects nil, list, vector, or set Data"))
  (let [capacity 0]
    (if (> n 0)
      (set! capacity (/ (core.count collection) n)))
    (let [out (arr.empty Data capacity)]
      (defer (delete-owned-array! out))
      (if (> n 0)
        (let [start 0]
          (while (<= (+ start n) (core.count collection))
            (let [group (range-vector collection start (+ start n))]
              (append-retained! (addr out) group))
            (set! start (+ start n)))))
      (freeze-items! .Vector (addr out)))))

(defn partition-all
  "Return owned vectors of up to `n` consecutive items.

  The final short group is included. Non-positive `n` returns an empty vector."
  [n: int, collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.partition-all expects nil, list, vector, or set Data"))
  (let [capacity 0]
    (if (> n 0)
      (set! capacity (/ (+ (core.count collection) (- n 1)) n)))
    (let [out (arr.empty Data capacity)]
      (defer (delete-owned-array! out))
      (if (> n 0)
        (let [start 0]
          (while (< start (core.count collection))
            (let [end (+ start n)]
              (if (> end (core.count collection))
                (set! end (core.count collection)))
              (let [group (range-vector collection start end)]
                (append-retained! (addr out) group)))
            (set! start (+ start n)))))
      (freeze-items! .Vector (addr out)))))

(defmacro partition-by
  "Partition whenever adjacent callback keys are structurally different."
  [f collection]
  `(partition-by-impl ~f ~collection))

(defn- partition-by-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.partition-by expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (if (= (core.count collection) 0)
      (return (freeze-items! .Vector (addr out))))
    (let [start 0
          previous-key (f (item-at collection 0))
          index 1]
      (while (< index (core.count collection))
        (let [key (f (item-at collection index))]
          (if (!= key previous-key)
            (do
              (let [group (range-vector collection start index)]
                (append-retained! (addr out) group))
              (set! start index)
              (set! previous-key key))))
        (inc! index))
      (let [group (range-vector collection start (core.count collection))]
        (append-retained! (addr out) group)))
    (freeze-items! .Vector (addr out))))

(defn interleave
  "Interleave two sequential Data inputs into an owned vector.

  Traversal stops when the shorter input is exhausted."
  [left: Data, right: Data] -> Data
  (if (not (and (sequential? left) (sequential? right)))
    (panic "data.interleave expects nil, list, vector, or set Data"))
  (let [limit (core.count left)]
    (if (> limit (core.count right))
      (set! limit (core.count right)))
    (let [out (arr.empty Data (* 2 limit))]
      (defer (delete-owned-array! out))
      (for [index (arr.range 0 limit)]
        (append-retained! (addr out) (item-at left index))
        (append-retained! (addr out) (item-at right index)))
      (freeze-items! .Vector (addr out)))))

(defn rest
  "Return an owned vector without the first sequential item."
  [collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.rest expects nil, list, vector, or set Data"))
  (if (= (core.count collection) 0)
    (range-vector collection 0 0)
    (range-vector collection 1 (core.count collection))))

(defn butlast
  "Return an owned vector without the last sequential item."
  [collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.butlast expects nil, list, vector, or set Data"))
  (let [end (- (core.count collection) 1)]
    (if (< end 0)
      (set! end 0))
    (range-vector collection 0 end)))

(defn take
  "Return an owned vector containing at most the first `n` items."
  [n: int, collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.take expects nil, list, vector, or set Data"))
  (let [end n]
    (if (< end 0)
      (set! end 0))
    (if (> end (core.count collection))
      (set! end (core.count collection)))
    (range-vector collection 0 end)))

(defn drop
  "Return an owned vector after dropping at most the first `n` items."
  [n: int, collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.drop expects nil, list, vector, or set Data"))
  (let [start n]
    (if (< start 0)
      (set! start 0))
    (if (> start (core.count collection))
      (set! start (core.count collection)))
    (range-vector collection start (core.count collection))))

(defn take-nth
  "Return an owned vector containing indexes `0`, `n`, `2n`, and so on."
  [n: int, collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.take-nth expects nil, list, vector, or set Data"))
  (let [capacity 0]
    (if (> n 0)
      (set! capacity (/ (+ (core.count collection) (- n 1)) n)))
    (let [out (arr.empty Data capacity)]
      (defer (delete-owned-array! out))
      (if (> n 0)
        (let [index 0]
          (while (< index (core.count collection))
            (append-retained! (addr out) (item-at collection index))
            (set! index (+ index n)))))
      (freeze-items! .Vector (addr out)))))

(defn peek
  "Return the borrowed stack item from list or vector Data, or nil."
  [collection: Data] -> Data #borrowed
  (if (nil? collection)
    (return 'nil))
  (if (list? collection)
    (return (first collection)))
  (if (vector? collection)
    (return (last collection)))
  (assert false "data.peek expects nil, list, or vector Data")
  'nil)

(defn pop
  "Return owned list or vector Data without its stack item."
  [collection: Data] -> Data
  (if (not (or (list? collection) (vector? collection)))
    (panic "data.pop expects list or vector Data"))
  (if (= (core.count collection) 0)
    (panic "data.pop expects a non-empty collection"))
  (let [out (arr.empty Data (- (core.count collection) 1))]
    (defer (delete-owned-array! out))
    (if (list? collection)
      (for [index (arr.range 1 (core.count collection))]
        (append-retained! (addr out) (item-at collection index)))
      (for [index (arr.range 0 (- (core.count collection) 1))]
        (append-retained! (addr out) (item-at collection index))))
    (if (list? collection)
      (freeze-items! .List (addr out))
      (freeze-items! .Vector (addr out)))))

(defmacro reduce
  "Eagerly reduce sequential Data from left to right with explicit `init`."
  [f init collection]
  `(reduce-impl ~f ~init ~collection))

(defn- reduce-impl
  [f: (fn [acc: $A, item: Data] -> A), init: A, collection: Data] -> A
  (if (not (sequential? collection))
    (panic "data.reduce expects nil, list, vector, or set Data"))
  (let [acc init]
    (for [index (arr.range 0 (core.count collection))]
      (set! acc (f acc (item-at collection index))))
    acc))

(defmacro some?
  "Return true when any sequential item satisfies `pred`."
  [pred collection]
  `(some-impl ~pred ~collection))

(defn- some-impl
  [pred: (fn [item: Data] -> bool), collection: Data] -> bool
  (if (not (sequential? collection))
    (panic "data.some? expects nil, list, vector, or set Data"))
  (for [index (arr.range 0 (core.count collection))]
    (if (pred (item-at collection index))
      (return true)))
  false)

(defmacro every?
  "Return true when every sequential item satisfies `pred`."
  [pred collection]
  `(every-impl ~pred ~collection))

(defn- every-impl
  [pred: (fn [item: Data] -> bool), collection: Data] -> bool
  (if (not (sequential? collection))
    (panic "data.every? expects nil, list, vector, or set Data"))
  (for [index (arr.range 0 (core.count collection))]
    (if (not (pred (item-at collection index)))
      (return false)))
  true)

(defmacro not-any?
  "Return true when no sequential item satisfies `pred`."
  [pred collection]
  `(not (some-impl ~pred ~collection)))

(defmacro not-every?
  "Return true when at least one sequential item fails `pred`."
  [pred collection]
  `(not (every-impl ~pred ~collection)))

(defmacro find
  "Return the first matching borrowed item and an `ok` flag."
  [pred collection]
  `(find-impl ~pred ~collection))

(defn- find-impl
  [pred: (fn [item: Data] -> bool), collection: Data]
  -> [value: Data, ok: bool] #borrowed
  (if (not (sequential? collection))
    (panic "data.find expects nil, list, vector, or set Data"))
  (for [index (arr.range 0 (core.count collection))]
    (let [item (item-at collection index)]
      (if (pred item)
        (return item true))))
  (return 'nil false))

(defmacro find-indexed
  "Return the first matching index, borrowed item, and an `ok` flag."
  [pred collection]
  `(find-indexed-impl ~pred ~collection))

(defn- find-indexed-impl
  [pred: (fn [index: int, item: Data] -> bool), collection: Data]
  -> [index: int, value: Data, ok: bool] #borrowed
  (if (not (sequential? collection))
    (panic "data.find-indexed expects nil, list, vector, or set Data"))
  (for [index (arr.range 0 (core.count collection))]
    (let [item (item-at collection index)]
      (if (pred index item)
        (return index item true))))
  (return -1 'nil false))

(defmacro min-by
  "Return the first item with the smallest native key and an `ok` flag."
  [f collection]
  `(min-by-impl ~f ~collection))

(defn- min-by-impl
  [f: (fn [item: Data] -> $K), collection: Data]
  -> [value: Data, ok: bool] #borrowed
  (if (not (sequential? collection))
    (panic "data.min-by expects nil, list, vector, or set Data"))
  (if (= (core.count collection) 0)
    (return 'nil false))
  (let [best (item-at collection 0)
        best-key (f best)]
    (for [index (arr.range 1 (core.count collection))]
      (let [item (item-at collection index)
            key (f item)]
        (if (< key best-key)
          (do
            (set! best item)
            (set! best-key key)))))
    (return best true)))

(defmacro max-by
  "Return the first item with the largest native key and an `ok` flag."
  [f collection]
  `(max-by-impl ~f ~collection))

(defn- max-by-impl
  [f: (fn [item: Data] -> $K), collection: Data]
  -> [value: Data, ok: bool] #borrowed
  (if (not (sequential? collection))
    (panic "data.max-by expects nil, list, vector, or set Data"))
  (if (= (core.count collection) 0)
    (return 'nil false))
  (let [best (item-at collection 0)
        best-key (f best)]
    (for [index (arr.range 1 (core.count collection))]
      (let [item (item-at collection index)
            key (f item)]
        (if (> key best-key)
          (do
            (set! best item)
            (set! best-key key)))))
    (return best true)))

(defmacro map
  "Eagerly map `f` over sequential Data into owned vector Data."
  [f collection]
  `(map-impl ~f ~collection))

(defn- map-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.map expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [mapped (f (item-at collection index))]
        (append-retained! (addr out) mapped)))
    (freeze-items! .Vector (addr out))))

(defmacro map-indexed
  "Eagerly map `(f index item)` into owned vector Data."
  [f collection]
  `(map-indexed-impl ~f ~collection))

(defn- map-indexed-impl
  [f: (fn [index: int, item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.map-indexed expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [mapped (f index (item-at collection index))]
        (append-retained! (addr out) mapped)))
    (freeze-items! .Vector (addr out))))

(defmacro filter
  "Eagerly retain sequential items for which `pred` returns true."
  [pred collection]
  `(filter-impl ~pred ~collection))

(defn- filter-impl
  [pred: (fn [item: Data] -> bool), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.filter expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)]
        (if (pred item)
          (append-retained! (addr out) item))))
    (freeze-items! .Vector (addr out))))

(defmacro remove
  "Eagerly retain sequential items for which `pred` returns false."
  [pred collection]
  `(remove-impl ~pred ~collection))

(defn- remove-impl
  [pred: (fn [item: Data] -> bool), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.remove expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)]
        (if (not (pred item))
          (append-retained! (addr out) item))))
    (freeze-items! .Vector (addr out))))

(defmacro keep
  "Eagerly map sequential Data and omit nil callback results."
  [f collection]
  `(keep-impl ~f ~collection))

(defn- keep-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.keep expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [mapped (f (item-at collection index))]
        (if (not (nil? mapped))
          (append-retained! (addr out) mapped))))
    (freeze-items! .Vector (addr out))))

(defmacro keep-indexed
  "Eagerly indexed-map sequential Data and omit nil callback results."
  [f collection]
  `(keep-indexed-impl ~f ~collection))

(defn- keep-indexed-impl
  [f: (fn [index: int, item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.keep-indexed expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [mapped (f index (item-at collection index))]
        (if (not (nil? mapped))
          (append-retained! (addr out) mapped))))
    (freeze-items! .Vector (addr out))))

(defmacro mapcat
  "Eagerly map to sequential Data and flatten one level into a vector."
  [f collection]
  `(mapcat-impl ~f ~collection))

(defn- mapcat-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.mapcat expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [mapped (f (item-at collection index))]
        (if (not (sequential? mapped))
          (panic "data.mapcat callback expects sequential Data"))
        (for [nested-index (arr.range 0 (core.count mapped))]
          (append-retained! (addr out) (item-at mapped nested-index)))))
    (freeze-items! .Vector (addr out))))

(defn- concat-two
  [left: Data, right: Data] -> Data
  (if (not (and (sequential? left) (sequential? right)))
    (panic "data.concat expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (+ (core.count left) (core.count right)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count left))]
      (append-retained! (addr out) (item-at left index)))
    (for [index (arr.range 0 (core.count right))]
      (append-retained! (addr out) (item-at right index)))
    (freeze-items! .Vector (addr out))))

(defmacro- concat-forms
  [collections]
  (if (= (count collections) 0)
    `(vec 'nil)
    (if (= (count collections) 1)
      `(vec ~(first collections))
      `(concat-two ~(first collections) ~(concat-forms (rest collections))))))

(defmacro concat
  "Eagerly concatenate zero or more sequential Data values into a vector."
  [& collections]
  (concat-forms collections))

(defn reverse
  "Return sequential Data items in reverse order as an owned vector."
  [collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.reverse expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (let [index (- (core.count collection) 1)]
      (while (>= index 0)
        (append-retained! (addr out) (item-at collection index))
        (set! index (- index 1))))
    (freeze-items! .Vector (addr out))))

(defn interpose
  "Return an owned vector with `separator` between sequential items."
  [separator: Data, collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.interpose expects nil, list, vector, or set Data"))
  (let [capacity 0]
    (if (> (core.count collection) 0)
      (set! capacity (- (* (core.count collection) 2) 1)))
    (let [out (arr.empty Data capacity)]
      (defer (delete-owned-array! out))
      (for [index (arr.range 0 (core.count collection))]
        (if (> index 0)
          (append-retained! (addr out) separator))
        (append-retained! (addr out) (item-at collection index)))
      (freeze-items! .Vector (addr out)))))

(defn- retained-array-contains?
  [values: []Data, value: Data] -> bool
  (for [existing values]
    (if (= existing value)
      (return true)))
  false)

(defn includes?
  "Return true when sequential Data contains a structurally equal item."
  [collection: Data, value: Data] -> bool
  (if (not (sequential? collection))
    (panic "data.includes? expects nil, list, vector, or set Data"))
  (for [index (arr.range 0 (core.count collection))]
    (if (= (item-at collection index) value)
      (return true)))
  false)

(defn distinct
  "Return structurally distinct sequential items in first-seen order."
  [collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.distinct expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)]
        (if (not (retained-array-contains? out[:] item))
          (append-retained! (addr out) item))))
    (freeze-items! .Vector (addr out))))

(defmacro distinct-by
  "Return the first item for each structurally distinct Data key."
  [f collection]
  `(distinct-by-impl ~f ~collection))

(defn- distinct-by-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.distinct-by expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! out))
    (let [keys (arr.empty Data (core.count collection)) :defer-with delete-owned-array!]
      (for [index (arr.range 0 (core.count collection))]
        (let [item (item-at collection index)
              key (f item)]
          (if (not (retained-array-contains? keys[:] key))
            (do
              (append-retained! (addr keys) key)
              (append-retained! (addr out) item)))))
      (freeze-items! .Vector (addr out)))))

(defmacro take-while
  "Return the longest sequential prefix satisfying `pred`."
  [pred collection]
  `(take-while-impl ~pred ~collection))

(defn- take-while-impl
  [pred: (fn [item: Data] -> bool), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.take-while expects nil, list, vector, or set Data"))
  (let [end 0]
    (while (and (< end (core.count collection))
                (pred (item-at collection end)))
      (set! end (+ end 1)))
    (range-vector collection 0 end)))

(defmacro drop-while
  "Drop the longest sequential prefix satisfying `pred`."
  [pred collection]
  `(drop-while-impl ~pred ~collection))

(defn- drop-while-impl
  [pred: (fn [item: Data] -> bool), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.drop-while expects nil, list, vector, or set Data"))
  (let [start 0]
    (while (and (< start (core.count collection))
                (pred (item-at collection start)))
      (set! start (+ start 1)))
    (range-vector collection start (core.count collection))))

(defmacro sort-by
  "Stable insertion sort by a native ordered callback key."
  [f collection]
  `(sort-by-impl ~f ~collection))

(defn- sort-by-impl
  [f: (fn [item: Data] -> $K), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.sort-by expects nil, list, vector, or set Data"))
  (let [items (arr.empty Data (core.count collection))
        keys (arr.empty K (core.count collection))]
    (defer
      (delete-owned-array! items)
      (delete keys))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)
            key (f item)
            target (core.count keys)]
        (arr.push! keys key)
        (append-retained! (addr items) item)
        (while (and (> target 0) (< key keys[(- target 1)]))
          (let [previous-key keys[(- target 1)]
                previous-item items[(- target 1)]]
            (set! keys[(- target 1)] keys[target])
            (set! items[(- target 1)] items[target])
            (set! keys[target] previous-key)
            (set! items[target] previous-item)
            (set! target (- target 1))))))
    (freeze-items! .Vector (addr items))))

(defmacro sort-with
  "Stable insertion sort with a native boolean item comparator."
  [before? collection]
  `(sort-with-impl ~before? ~collection))

(defn- sort-with-impl
  [before?: (fn [left: Data, right: Data] -> bool), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.sort-with expects nil, list, vector, or set Data"))
  (let [items (arr.empty Data (core.count collection))]
    (defer (delete-owned-array! items))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)
            target (core.count items)]
        (append-retained! (addr items) item)
        (while (and (> target 0) (before? item items[(- target 1)]))
          (let [previous items[(- target 1)]]
            (set! items[(- target 1)] items[target])
            (set! items[target] previous)
            (set! target (- target 1))))))
    (freeze-items! .Vector (addr items))))

(defmacro reduce-kv
  "Eagerly reduce map entries with `(f acc key value)`."
  [f init value]
  `(reduce-kv-impl ~f ~init ~value))

(defn- reduce-kv-impl
  [f: (fn [acc: $A, key: Data, value: Data] -> A), init: A, map-value: Data] -> A
  (if (not (map-like? map-value))
    (panic "data.reduce-kv expects map or nil Data"))
  (let [acc init]
    (for [index (arr.range 0 (core.count map-value))]
      (set! acc (f acc (key-at map-value index) (value-at map-value index))))
    acc))

(defn select-keys
  "Return an owned map containing requested keys that are present."
  [map-value: Data, selected: Data] -> Data
  (if (not (map-like? map-value))
    (panic "data.select-keys expects map or nil Data"))
  (if (not (sequential? selected))
    (panic "data.select-keys expects sequential key Data"))
  (let [out (arr.empty Data (* 2 (core.count selected)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count selected))]
      (let [key (item-at selected index)]
        (if (core.contains? map-value key)
          (append-pair-retained! (addr out) key (core.get map-value key)))))
    (freeze-map! (addr out))))

(defmacro merge-with
  "Merge maps, combining collisions with `(f left-value right-value)`."
  [f left right]
  `(merge-with-impl ~f ~left ~right))

(defn- merge-with-impl
  [f: (fn [left: Data, right: Data] -> Data), left: Data, right: Data] -> Data
  (if (not (and (map-like? left) (map-like? right)))
    (panic "data.merge-with expects map or nil Data"))
  (let [out (arr.empty Data (* 2 (+ (core.count left) (core.count right))))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count left))]
      (append-pair-retained!
       (addr out) (key-at left index) (value-at left index)))
    (for [index (arr.range 0 (core.count right))]
      (let [key (key-at right index)
            right-value (value-at right index)]
        (if (core.contains? left key)
          (let [combined (f (core.get left key) right-value)]
            (append-pair-retained! (addr out) key combined))
          (append-pair-retained! (addr out) key right-value))))
    (freeze-map! (addr out))))

(defmacro update-keys
  "Return a map whose keys are transformed by `f`."
  [f value]
  `(update-keys-impl ~f ~value))

(defn- update-keys-impl
  [f: (fn [key: Data] -> Data), map-value: Data] -> Data
  (if (not (map-like? map-value))
    (panic "data.update-keys expects map or nil Data"))
  (let [out (arr.empty Data (* 2 (core.count map-value)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count map-value))]
      (let [key (f (key-at map-value index))]
        (append-pair-retained!
         (addr out) key (value-at map-value index))))
    (freeze-map! (addr out))))

(defmacro update-vals
  "Return a map whose values are transformed by `f`."
  [f value]
  `(update-vals-impl ~f ~value))

(defn- update-vals-impl
  [f: (fn [value: Data] -> Data), map-value: Data] -> Data
  (if (not (map-like? map-value))
    (panic "data.update-vals expects map or nil Data"))
  (let [out (arr.empty Data (* 2 (core.count map-value)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count map-value))]
      (let [value (f (value-at map-value index))]
        (append-pair-retained!
         (addr out) (key-at map-value index) value)))
    (freeze-map! (addr out))))

(defn zipmap
  "Build a map from sequential keys and values, stopping at the shorter input."
  [key-values: Data, values: Data] -> Data
  (if (not (and (sequential? key-values) (sequential? values)))
    (panic "data.zipmap expects sequential Data"))
  (let [limit (core.count key-values)]
    (if (> limit (core.count values))
      (set! limit (core.count values)))
    (let [out (arr.empty Data (* 2 limit))]
      (defer (delete-owned-array! out))
      (for [index (arr.range 0 limit)]
        (append-pair-retained!
         (addr out)
         (item-at key-values index)
         (item-at values index)))
      (freeze-map! (addr out)))))

(defmacro map-entries
  "Transform map entries with a callback returning `[key value]` Data."
  [f value]
  `(map-entries-impl ~f ~value))

(defn- map-entries-impl
  [f: (fn [entry-key: Data, entry-value: Data] -> Data),
   map-value: Data] -> Data
  (if (not (map-like? map-value))
    (panic "data.map-entries expects map or nil Data"))
  (let [out (arr.empty Data (* 2 (core.count map-value)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count map-value))]
      (let [entry (f (key-at map-value index) (value-at map-value index))]
        (if (not (and (or (list? entry) (vector? entry))
                      (= (core.count entry) 2)))
          (panic "data.map-entries callback expects two-item entry Data"))
        (append-pair-retained!
         (addr out) (item-at entry 0) (item-at entry 1))))
    (freeze-map! (addr out))))

(defmacro filter-entries
  "Keep map entries for which `(pred key value)` returns true."
  [pred value]
  `(filter-entries-impl ~pred ~value))

(defn- filter-entries-impl
  [pred: (fn [key: Data, value: Data] -> bool), map-value: Data] -> Data
  (if (not (map-like? map-value))
    (panic "data.filter-entries expects map or nil Data"))
  (let [out (arr.empty Data (* 2 (core.count map-value)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count map-value))]
      (let [key (key-at map-value index)
            value (value-at map-value index)]
        (if (pred key value)
          (append-pair-retained! (addr out) key value))))
    (freeze-map! (addr out))))

(defn- data-index
  [values: []Data, value: Data] -> i64
  (for [existing index values]
    (if (odin-call "kvist_data_equal" existing value)
      (return (i64 index))))
  (i64 -1))

(defmacro group-by
  "Group sequential items into vectors keyed by Data callback results."
  [f collection]
  `(group-by-impl ~f ~collection))

(defn- group-by-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.group-by expects nil, list, vector, or set Data"))
  (let [group-keys (arr.empty Data (core.count collection))
        counts (arr.empty i64 (core.count collection))
        item-groups (arr.empty i64 (core.count collection))]
    (defer
      (for [key group-keys]
        (release key))
      (delete group-keys)
      (delete counts)
      (delete item-groups))
    (for [index (arr.range 0 (core.count collection))]
      (let [key (f (item-at collection index))
            group-index (data-index group-keys[:] key)]
        (if (= group-index -1)
          (do
            (set! group-index (i64 (core.count group-keys)))
            (append-retained! (addr group-keys) key)
            (arr.push! counts 1))
          (set! counts[group-index] (+ counts[group-index] 1)))
        (arr.push! item-groups group-index)))
    (let [starts (arr.empty i64 (core.count counts))
          positions (arr.empty i64 (core.count counts))
          next-start (i64 0)]
      (defer
        (delete starts)
        (delete positions))
      (for [group-count counts]
        (arr.push! starts next-start)
        (arr.push! positions 0)
        (set! next-start (+ next-start group-count)))
      (let [flat (arr.empty Data (core.count collection))]
        (defer
          (for [item flat]
            (release item))
          (delete flat))
        (resize (addr flat) (core.count collection))
        (for [index (arr.range 0 (core.count collection))]
          (let [group-index item-groups[index]
                target (+ starts[group-index] positions[group-index])]
            (set! flat[target] (retain (item-at collection index)))
            (set! positions[group-index] (+ positions[group-index] 1))))
        (let [out (arr.empty Data (* 2 (core.count group-keys)))]
          (defer (delete-owned-array! out))
          (for [group-index (arr.range 0 (core.count group-keys))]
            (let [start starts[group-index]
                  end (+ start counts[group-index])
                  group (vector-from-array (core.slice flat start end))]
              (append-pair-retained!
               (addr out) group-keys[group-index] group)))
          (freeze-map! (addr out)))))))

(defmacro index-by
  "Build a map from callback key to item; later items win."
  [f collection]
  `(index-by-impl ~f ~collection))

(defn- index-by-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.index-by expects nil, list, vector, or set Data"))
  (let [out (arr.empty Data (* 2 (core.count collection)))]
    (defer (delete-owned-array! out))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)
            key (f item)]
        (append-pair-retained! (addr out) key item)))
    (freeze-map! (addr out))))

(defn frequencies
  "Return a map from each distinct item to integer Data count."
  [collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.frequencies expects nil, list, vector, or set Data"))
  (let [frequency-keys (arr.empty Data (core.count collection))
        counts (arr.empty i64 (core.count collection))]
    (defer
      (for [key frequency-keys]
        (release key))
      (delete frequency-keys)
      (delete counts))
    (for [index (arr.range 0 (core.count collection))]
      (let [item (item-at collection index)
            found (data-index frequency-keys[:] item)]
        (if (= found -1)
          (do
            (append-retained! (addr frequency-keys) item)
            (arr.push! counts 1))
          (set! counts[found] (+ counts[found] 1)))))
    (let [out (arr.empty Data (* 2 (core.count frequency-keys)))]
      (defer (delete-owned-array! out))
      (for [index (arr.range 0 (core.count frequency-keys))]
        (let [count-value (from-int (i64 counts[index]))]
          (append-pair-retained!
           (addr out) frequency-keys[index] count-value)))
      (freeze-map! (addr out)))))

(defmacro count-by
  "Count sequential items by structurally equal Data callback keys."
  [f collection]
  `(count-by-impl ~f ~collection))

(defn- count-by-impl
  [f: (fn [item: Data] -> Data), collection: Data] -> Data
  (if (not (sequential? collection))
    (panic "data.count-by expects nil, list, vector, or set Data"))
  (let [count-keys (arr.empty Data (core.count collection))
        counts (arr.empty i64 (core.count collection))]
    (defer
      (for [key count-keys]
        (release key))
      (delete count-keys)
      (delete counts))
    (for [index (arr.range 0 (core.count collection))]
      (let [key (f (item-at collection index))
            found (data-index count-keys[:] key)]
        (if (= found -1)
          (do
            (append-retained! (addr count-keys) key)
            (arr.push! counts 1))
          (set! counts[found] (+ counts[found] 1)))))
    (let [out (arr.empty Data (* 2 (core.count count-keys)))]
      (defer (delete-owned-array! out))
      (for [index (arr.range 0 (core.count count-keys))]
        (let [count-value (from-int counts[index])]
          (append-pair-retained!
           (addr out) count-keys[index] count-value)))
      (freeze-map! (addr out)))))

(defn into
  "Eagerly conjoin sequential source Data into list, vector, set, or map Data."
  [target: Data, source: Data] -> Data
  (if (not (sequential? source))
    (panic "data.into expects sequential source Data"))
  (if (map? target)
    (let [out (arr.empty Data (* 2 (+ (core.count target) (core.count source))))]
      (defer
        (for [item out]
          (release item))
        (delete out))
      (for [index (arr.range 0 (core.count target))]
        (append-pair-retained!
         (addr out) (key-at target index) (value-at target index)))
      (for [index (arr.range 0 (core.count source))]
        (let [entry (item-at source index)]
          (if (not (and (or (list? entry) (vector? entry))
                        (= (core.count entry) 2)))
            (panic "data.into map target expects two-item entry Data"))
          (append-pair-retained!
           (addr out) (item-at entry 0) (item-at entry 1))))
      (return (freeze-map! (addr out)))))
  (if (not (or (list? target) (vector? target) (set? target)))
    (panic "data.into target expects list, vector, set, or map Data"))
  (let [out (arr.empty Data (+ (core.count target) (core.count source)))]
    (defer (delete-owned-array! out))
    (if (list? target)
      (do
        (let [index (- (core.count source) 1)]
          (while (>= index 0)
            (append-retained! (addr out) (item-at source index))
            (set! index (- index 1))))
        (for [index (arr.range 0 (core.count target))]
          (append-retained! (addr out) (item-at target index))))
      (do
        (for [index (arr.range 0 (core.count target))]
          (append-retained! (addr out) (item-at target index)))
        (for [index (arr.range 0 (core.count source))]
          (let [item (item-at source index)]
            (if (or (not (set? target))
                    (not (retained-array-contains? out[:] item)))
              (append-retained! (addr out) item))))))
    (if (list? target)
      (freeze-items! .List (addr out))
      (if (set? target)
        (freeze-items! .Set (addr out))
        (freeze-items! .Vector (addr out))))))
