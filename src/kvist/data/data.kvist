(package data)
(import core "kvist:core")
(import arr "kvist:arr")

(defstruct Decode-Error
  "Describe why Data decoding failed and where the incompatible value occurred."
  {
  path: Data
  expected: Data-Kind
  actual: Data-Kind
  enum-value?: bool
  expected-type: string
  actual-value: Data
})

(defn decode-error
  "Construct a decoding error for an expected and actual Data kind."
  [path: Data, expected: Data-Kind, actual: Data-Kind] -> Decode-Error
  (Decode-Error {path: path expected: expected actual: actual}))

(defn- decode-enum-error
  [path: Data, expected-type: string, actual-value: Data] -> Decode-Error
  (Decode-Error {
    path: path
    expected: .Keyword
    actual: (kind actual-value)
    enum-value?: true
    expected-type: expected-type
    actual-value: actual-value
  }))

(defmacro decode
  "Decode Data into a native value selected by type.

  `(decode Person value)` and `(decode (dynamic i64) value)` return
  `[decoded err ok]`. An optional third argument supplies the Data path used
  as the root of path-aware errors."
  [target-type value & rest]
  (if (= (count rest) 0)
    `(decode-data ~target-type ~value)
    (if (= (count rest) 1)
      `(decode-data ~target-type ~value ~(first rest))
      (error "data.decode expects type, value, and optional path"))))

(defmacro validate
  "Validate Data against the shape selected by a native type without decoding.

  `(validate Person value)` returns `[err ok]`. An optional third argument
  supplies the Data path used as the root of path-aware errors."
  [target-type value & rest]
  (if (= (count rest) 0)
    `(validate-data ~target-type ~value)
    (if (= (count rest) 1)
      `(validate-data ~target-type ~value ~(first rest))
      (error "data.validate expects type, value, and optional path"))))

(defn from-nil
  "Construct nil Data."
  [] -> Data #force_inline
  (odin-call "kvist_data_make_nil"))

(defn from-bool
  "Construct boolean Data."
  [value: bool] -> Data #force_inline
  (odin-call "kvist_data_make_bool" value))

(defn from-int
  "Construct integer Data."
  [value: i64] -> Data #force_inline
  (odin-call "kvist_data_make_int" value))

(defn from-float
  "Construct floating-point Data."
  [value: f64] -> Data #force_inline
  (odin-call "kvist_data_make_float" value))

(defn from-string
  "Construct string Data with owned immutable text."
  [value: string] -> Data #force_inline
  (odin-call "kvist_data_make_text" .String value))

(defn from-symbol
  "Construct symbol Data with owned immutable text."
  [value: string] -> Data #force_inline
  (odin-call "kvist_data_make_text" .Symbol value))

(defn from-keyword
  "Construct keyword Data with owned immutable text."
  [value: string] -> Data #force_inline
  (odin-call "kvist_data_make_text" .Keyword value))

(defn list-from-array
  "Construct list Data from a native array, retaining each element."
  [values: []Data] -> Data #force_inline
  (odin-call "kvist_data_make_items" .List values))

(defn vector-from-array
  "Construct vector Data from a native array, retaining each element."
  [values: []Data] -> Data #force_inline
  (odin-call "kvist_data_make_items" .Vector values))

(defn set-from-array
  "Construct set Data from a native array, retaining each distinct element."
  [values: []Data] -> Data #force_inline
  (odin-call "kvist_data_make_items" .Set values))

(defn set-from-unique
  "Construct set Data from values already known to be structurally unique.

  This retains each element without checking for duplicates. Use `set` when
  uniqueness has not already been established."
  [values: []Data] -> Data #force_inline
  (odin-call "kvist_data_make_unique_set" values))

(defn map-from-alternating
  "Construct map Data from an alternating native array of keys and values."
  [values: []Data] -> Data #force_inline
  (odin-call "kvist_data_make_map" values))

(defn empty-map
  "Construct empty map Data."
  [] -> Data #force_inline
  (odin-call "kvist_data_empty_map"))

(defn tagged
  "Construct tagged Data, retaining `value` and owning a copy of `tag`.

  The tag excludes EDN's leading `#`; for example, use `\"uuid\"`."
  [tag: string, value: Data] -> Data #force_inline
  (odin-call "kvist_data_make_tagged" tag value))
