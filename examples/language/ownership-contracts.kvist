(package main)

(import arr "kvist:arr")
(import data "kvist:data")

(defn make-values [] -> [dynamic]int
  (arr.range 0 5))

(defn inspect-values [values: [dynamic]int] -> int
  (count values))

(defn consume-values [values: [dynamic]int] -> int
  (let [result (count values)]
    (delete values)
    result))

(defn forward-data [value: Data] -> Data
  value)

(defn inspect-data [value: Data] -> Data
  value)

(defn main []
  (let [values (make-values)]
    (println (inspect-values values))
    (println (consume-values values)))
  (let [value (data.from-string "managed")]
    (println (data.string (inspect-data (forward-data value)))))
  (let [temporary (make-values) :defer]
    (println (inspect-values temporary))))
