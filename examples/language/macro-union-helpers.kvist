;; A more substantial declaration DSL. The helper macro recursively walks
;; union variants and emits one constructor helper per variant.
(defmacro emit-union-ctors [union-name variants]
  (if (= (count variants) 0)
    (forms)
    (let [tag (first variants)
          value-type (nth variants 1)
          ctor-name (symbol (str "make-" (name union-name) "-" (name tag)))]
      (forms
        `(defn ~ctor-name [value: ~value-type] -> ~union-name
           (~union-name {~tag value}))
        (emit-union-ctors union-name (rest (rest variants)))))))

(defmacro defunion+ctors [name variants]
  (forms
    `(defunion ~name ~variants)
    (emit-union-ctors name variants)))

(defunion+ctors Value {
  i: int
  s: string
  ok: bool
})

(defn macro-union-helpers-demo []
  (let [number (make-Value-i 42)
        text (make-Value-s "kvist")
        flag (make-Value-ok true)]
    (println number)
    (println text)
    (println flag)))

(defn main []
  (macro-union-helpers-demo))
