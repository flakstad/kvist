;; Demonstrates first-class keyword values in ordinary Odin-shaped Kvist code.
(package main)

(defstruct Config [
  mode: keyword
  backend: keyword
  name: string
])

(defstruct Job [
  state: keyword
  label: string
])

(defn default-config [] -> Config
  (Config :mode :env/dev
           :backend :db/sqlite
           :name "local"))

(defn next-job-state [state: keyword, attempts: int] -> keyword
  (case state
    :job/queued (if (> attempts 0) :job/retrying :job/running)
    :job/retrying :job/running
    :job/running :job/done
    :job/done :job/done
    :job/unknown))

(defn state-rank [state: keyword] -> int
  (case state
    :job/queued 0
    :job/retrying 1
    :job/running 2
    :job/done 3
    -1))

(defn keyword-literals-demo [] -> int
  (let [job (Job :state :job/queued :label "thumbnail")
        transitions {:job/queued 1 :job/running 2 :job/done 3} :defer
        enabled #{:env/dev :env/test} :defer]
    (println enabled)
    (+ (state-rank job.state)
       (get transitions :job/running))))

(defn main []
  (let [config (default-config)]
    (println config.mode config.backend config.name)
    (println (next-job-state :job/queued 0))
    (println (keyword-literals-demo))))

(comment
  (default-config)
  ;; => (Config :mode :env/dev :backend :db/sqlite :name "local")

  (next-job-state :job/queued 0)
  ;; => :job/running

  (next-job-state :job/running 0)
  ;; => :job/done

  (keyword-literals-demo)
  ;; => 2
)
