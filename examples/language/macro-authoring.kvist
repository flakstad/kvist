;; Macro authoring examples: validation, multiple returned forms, gensym, and
;; field-selector inspection.

(defmacro deffield-name [const-name field]
  (if (and (symbol? const-name) (field-selector? field))
    (let [typed-name (symbol (str (name const-name) ":"))]
      `(def ~typed-name string ~(name field)))
    (error "deffield-name expects a field selector such as .name")))

(defmacro defstring-fn [fn-name value]
  (let [tmp (gensym "value")]
    `(defn ~fn-name [] -> string
       (let [~tmp ~value]
         ~tmp))))

(defmacro tag-kind [tag]
  (if (contains? ["info" "warn"] (name tag))
    (quote "shown")
    (quote "hidden")))

(defmacro compact-fields? [fields]
  (if (and (vector? fields)
           (<= (count fields) 4))
    (quote true)
    (quote false)))

(defmacro defentity [name fields]
  (if (vector? fields)
    (let [make-name (symbol (str "make-" (name name)))]
      (forms
        `(defstruct ~name ~fields)
        `(defn ~make-name [] -> ~name
           (~name))))
    (error "defentity expects a field vector")))

(defentity User [name: string age: int])
(deffield-name User-Name-Field .name)
(defstring-fn greeting "hello")
(def Tag-Label: string (tag-kind info))
(def Compact-User-Fields: bool (compact-fields? [name: string age: int]))

(defn macro-authoring-demo [] -> string
  (let [user (make-User)]
    (if (and (= User-Name-Field "name")
             (= Tag-Label "shown")
             Compact-User-Fields)
      (greeting)
      user.name)))

(defn main []
  (println (macro-authoring-demo)))
