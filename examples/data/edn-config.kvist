(package main)
(import data "kvist:data")
(import edn "kvist:edn")

(defn read-config [] -> Data
  (edn.read "{:port 8080 :features #{:query :pull}}"))

(defn main []
  (let [config (read-config)]
    (println (data.int (get config :port))
             (contains? (get config :features) :query))))
