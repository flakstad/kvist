(package main)
(import data "kvist:data")
(import edn "kvist:edn")

(def config
  '{:port 8080
    :name "vev\nlocal"
    :features #{:query :pull}})

(defn main []
  (let [text (edn.write config) :defer
        parsed (edn.read text)
        sample (edn.read "[nil true false -12 3.5 foo/bar :a/b (1 2) #{3 4} {; note\n:x \"y\\tvalue\"}]")
        expected '[nil true false -12 3.5 foo/bar :a/b (1 2) #{3 4} {:x "y\tvalue"}]
        [invalid error ok] (edn.try-read "{:port 8080")
        [_ trailing-error trailing-ok] (edn.try-read "1 2")
        tagged (edn.read "#demo/value {:answer 42}")
        tagged-text (edn.write tagged) :defer
        symbols (edn.read "[_ + -]")
        [_ missing-tag-error missing-tag-ok] (edn.try-read "# 1")
        [_ missing-value-error missing-value-ok] (edn.try-read "#demo/value")
        [_ duplicate-error duplicate-ok] (edn.try-read "{:port 8080 :port 8081}")]
    (assert (= text "{:port 8080 :name \"vev\\nlocal\" :features #{:query :pull}}"))
    (assert (= parsed config))
    (assert (= sample expected))
    (assert (not ok))
    (assert (= error.message "unterminated map"))
    (assert (data.nil? invalid))
    (assert (not trailing-ok))
    (assert (= trailing-error.message "trailing EDN input"))
    (assert (data.tagged? tagged))
    (assert (= (data.tag tagged) "demo/value"))
    (assert (= (data.tagged-value tagged) '{:answer 42}))
    (assert (= tagged-text "#demo/value {:answer 42}"))
    (assert (= (edn.read tagged-text) tagged))
    (assert (= symbols '[_ + -]))
    (assert (not missing-tag-ok))
    (assert (= missing-tag-error.message "expected EDN tag"))
    (assert (not missing-value-ok))
    (assert (= missing-value-error.message "tagged literal requires a value"))
    (assert (not duplicate-ok))
    (assert (= duplicate-error.message "duplicate map key"))
    (assert (= duplicate-error.form ":port"))))
