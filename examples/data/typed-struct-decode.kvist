(package main)
(import data "kvist:data")

(defenum Mode [
  Manual
  Automatic
  Read-Only
])

(defstruct Endpoint {
  host-id: i64
  display-name: (owned string)
  secure: bool
  tags: Data
})

(defstruct Settings {
  port: i64
  enabled: bool
  ratio: f64
  metadata: Data
  endpoint: Endpoint
  mode: Mode
})

(defn main []
  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {:source :config}
            :endpoint {:host-id 7
                       :display-name "primary"
                       :secure true
                       :tags [:primary]}
            :mode :read-only})]
    (assert ok)
    (assert (= settings.port 8080))
    (assert settings.enabled)
    (assert (= settings.ratio 0.5))
    (assert (= settings.metadata '{:source :config}))
    (assert (= settings.endpoint.host-id 7))
    (assert (= settings.endpoint.display-name "primary"))
    (assert settings.endpoint.secure)
    (assert (= settings.endpoint.tags '[:primary]))
    (assert (= settings.mode .Read-Only))
    (let [mutable settings.endpoint]
      (set! mutable.display-name "mutable")
      (assert (= mutable.display-name "mutable")))
    (let [renamed (assoc settings .endpoint.display-name "backup")]
      (assert (= settings.endpoint.display-name "primary"))
      (assert (= renamed.endpoint.display-name "backup")))
    (discard err))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {}
            :endpoint {:host-id 7
                       :display-name "primary"
                       :secure true
                       :tags []}
            :mode :sometimes}
          '[:settings])]
    (assert (not ok))
    (assert (= err.path '[:settings :mode]))
    (assert err.enum-value?)
    (assert (= err.expected .Keyword))
    (assert (= err.actual .Keyword))
    (assert (= err.expected-type "Mode"))
    (assert (= err.actual-value ':sometimes))
    (discard settings)))
