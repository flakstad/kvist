(package main)
(import data "kvist:data")

(defenum Mode [
  Manual
  Automatic
  Read-Only
])

(defstruct Endpoint {
  host-id: i64
  display-name: (owned string) :default "unnamed"
  secure: bool :default false
  tags: Data :default '[]
})

(defstruct Settings {
  port: i64
  enabled: bool
  ratio: f64 :default 1.0
  metadata: Data :default '{}
  endpoint: Endpoint
  mode: Mode :default .Manual
  fallback-endpoint: Endpoint :default (Endpoint {host-id: -1})
})

(defn main []
  (let [endpoint (Endpoint {host-id: 6})]
    (assert (= endpoint.display-name "unnamed"))
    (assert (not endpoint.secure))
    (assert (= endpoint.tags '[])))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {:source :config}
            :endpoint {:host-id 7
                       :display-name "primary"
                       :secure true
                       :tags [:primary]}
            :mode :read-only})]
    (assert ok)
    (assert (= settings.port 8080))
    (assert settings.enabled)
    (assert (= settings.ratio 0.5))
    (assert (= settings.metadata '{:source :config}))
    (assert (= settings.endpoint.host-id 7))
    (assert (= settings.endpoint.display-name "primary"))
    (assert settings.endpoint.secure)
    (assert (= settings.endpoint.tags '[:primary]))
    (assert (= settings.mode .Read-Only))
    (let [mutable settings.endpoint]
      (set! mutable.display-name "mutable")
      (assert (= mutable.display-name "mutable")))
    (let [renamed (assoc settings .endpoint.display-name "backup")]
      (assert (= settings.endpoint.display-name "primary"))
      (assert (= renamed.endpoint.display-name "backup")))
    (discard err))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8081
            :enabled false
            :endpoint {:host-id 8}})]
    (assert ok)
    (assert (= settings.ratio 1.0))
    (assert (= settings.metadata '{}))
    (assert (= settings.endpoint.display-name "unnamed"))
    (assert (not settings.endpoint.secure))
    (assert (= settings.endpoint.tags '[]))
    (assert (= settings.mode .Manual))
    (assert (= settings.fallback-endpoint.host-id -1))
    (assert (= settings.fallback-endpoint.display-name "unnamed"))
    (discard err))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8082
            :enabled true
            :ratio nil
            :endpoint {:host-id 9}})]
    (assert (not ok))
    (assert (= err.path '[:ratio]))
    (assert (= err.expected .Float))
    (assert (= err.actual .Nil))
    (discard settings))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {}
            :endpoint {:host-id 7
                       :display-name "primary"
                       :secure true
                       :tags []}
            :mode :sometimes}
          '[:settings])]
    (assert (not ok))
    (assert (= err.path '[:settings :mode]))
    (assert err.enum-value?)
    (assert (= err.expected .Keyword))
    (assert (= err.actual .Keyword))
    (assert (= err.expected-type "Mode"))
    (assert (= err.actual-value ':sometimes))
    (discard settings)))
