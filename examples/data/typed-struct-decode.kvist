(package main)
(import data "kvist:data")

(defenum Mode [
  Manual
  Automatic
  Read-Only
])

(defstruct Endpoint [
  host-id: i64
  display-name: string :default "unnamed"
  secure: bool :default false
  tags: Data :default '[]
])

(defstruct Settings [
  port: i64
  enabled: bool
  ratio: f64 :default 1.0
  metadata: Data :default '{}
  endpoint: Endpoint
  mode: Mode :default .Manual
  fallback-endpoint: Endpoint :default (Endpoint :host-id -1)
  scores: [dynamic]i64 :default []
  raw-items: [dynamic]Data :default []
  flags: [dynamic]bool :default []
  ratios: [dynamic]f64 :default []
  modes: [dynamic]Mode :default []
  endpoints: [dynamic]Endpoint :default []
])

(defn main []
  (let [endpoint (Endpoint :host-id 6)]
    (assert (= endpoint.display-name "unnamed"))
    (assert (not endpoint.secure))
    (assert (= endpoint.tags '[])))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {:source :config}
            :endpoint {:host-id 7
                       :display-name "primary"
                       :secure true
                       :tags [:primary]}
            :mode :read-only
            :scores [10 20 30]
            :raw-items [1 :two]
            :flags [true false]
            :ratios [0.25 0.75]
            :modes [:manual :read-only]
            :endpoints [{:host-id 21
                         :display-name "secondary"}
                        {:host-id 22
                         :tags [:remote]}]})]
    (assert ok)
    (assert (= settings.port 8080))
    (assert settings.enabled)
    (assert (= settings.ratio 0.5))
    (assert (= settings.metadata '{:source :config}))
    (assert (= settings.endpoint.host-id 7))
    (assert (= settings.endpoint.display-name "primary"))
    (assert settings.endpoint.secure)
    (assert (= settings.endpoint.tags '[:primary]))
    (assert (= settings.mode .Read-Only))
    (assert (= (count settings.scores) 3))
    (assert (= settings.scores[1] 20))
    (assert (= settings.raw-items[0] '1))
    (assert (= settings.raw-items[1] ':two))
    (assert settings.flags[0])
    (assert (not settings.flags[1]))
    (assert (= settings.ratios[1] 0.75))
    (assert (= settings.modes[0] .Manual))
    (assert (= settings.modes[1] .Read-Only))
    (assert (= (count settings.endpoints) 2))
    (assert (= settings.endpoints[0].display-name "secondary"))
    (assert (= settings.endpoints[1].display-name "unnamed"))
    (assert (= settings.endpoints[1].tags '[:remote]))
    (let [copied settings]
      (set! copied.endpoints[0].host-id 99)
      (assert (= settings.endpoints[0].host-id 21))
      (assert (= copied.endpoints[0].host-id 99)))
    (let [copied settings]
      (set! copied.scores[0] 99)
      (assert (= settings.scores[0] 10))
      (assert (= copied.scores[0] 99)))
    (let [mutable settings]
      (set! mutable.scores ([dynamic]i64 [4 5]))
      (assert (= (count mutable.scores) 2))
      (assert (= mutable.scores[0] 4)))
    (let [rescored (assoc settings .scores ([dynamic]i64 [7 8]))]
      (assert (= settings.scores[0] 10))
      (assert (= rescored.scores[0] 7)))
    (let [mutable settings.endpoint]
      (set! mutable.display-name "mutable")
      (assert (= mutable.display-name "mutable")))
    (let [renamed (assoc settings .endpoint.display-name "backup")]
      (assert (= settings.endpoint.display-name "primary"))
      (assert (= renamed.endpoint.display-name "backup")))
    (discard err))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8081
            :enabled false
            :endpoint {:host-id 8}})]
    (assert ok)
    (assert (= settings.ratio 1.0))
    (assert (= settings.metadata '{}))
    (assert (= settings.endpoint.display-name "unnamed"))
    (assert (not settings.endpoint.secure))
    (assert (= settings.endpoint.tags '[]))
    (assert (= settings.mode .Manual))
    (assert (= settings.fallback-endpoint.host-id -1))
    (assert (= settings.fallback-endpoint.display-name "unnamed"))
    (assert (= (count settings.scores) 0))
    (assert (= (count settings.raw-items) 0))
    (assert (= (count settings.flags) 0))
    (assert (= (count settings.ratios) 0))
    (assert (= (count settings.modes) 0))
    (assert (= (count settings.endpoints) 0))
    (discard err))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8082
            :enabled true
            :ratio nil
            :endpoint {:host-id 9}})]
    (assert (not ok))
    (assert (= err.path '[:ratio]))
    (assert (= err.expected .Float))
    (assert (= err.actual .Nil))
    (discard settings))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8083
            :enabled true
            :endpoint {:host-id 10}
            :scores [1 :bad 3]})]
    (assert (not ok))
    (assert (= err.path '[:scores 1]))
    (assert (= err.expected .Int))
    (assert (= err.actual .Keyword))
    (discard settings))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8084
            :enabled true
            :endpoint {:host-id 11}
            :modes [:manual :sometimes]})]
    (assert (not ok))
    (assert (= err.path '[:modes 1]))
    (assert err.enum-value?)
    (assert (= err.expected .Keyword))
    (assert (= err.actual .Keyword))
    (assert (= err.expected-type "Mode"))
    (assert (= err.actual-value ':sometimes))
    (discard settings))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8085
            :enabled true
            :endpoint {:host-id 12}
            :endpoints [{:host-id 1}
                        {:host-id "bad"}]})]
    (assert (not ok))
    (assert (= err.path '[:endpoints 1 :host-id]))
    (assert (= err.expected .Int))
    (assert (= err.actual .String))
    (discard settings))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {}
            :endpoint {:host-id 7
                       :display-name "primary"
                       :secure true
                       :tags []}
            :mode :sometimes}
          '[:settings])]
    (assert (not ok))
    (assert (= err.path '[:settings :mode]))
    (assert err.enum-value?)
    (assert (= err.expected .Keyword))
    (assert (= err.actual .Keyword))
    (assert (= err.expected-type "Mode"))
    (assert (= err.actual-value ':sometimes))
    (discard settings)))
