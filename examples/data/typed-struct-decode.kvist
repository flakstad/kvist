(package main)
(import data "kvist:data")

(defstruct Endpoint {
  host-id: i64
  secure: bool
  tags: Data
})

(defstruct Settings {
  port: i64
  enabled: bool
  ratio: f64
  metadata: Data
  endpoint: Endpoint
})

(defn main []
  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {:source :config}
            :endpoint {:host-id 7
                       :secure true
                       :tags [:primary]}})]
    (assert ok)
    (assert (= settings.port 8080))
    (assert settings.enabled)
    (assert (= settings.ratio 0.5))
    (assert (= settings.metadata '{:source :config}))
    (assert (= settings.endpoint.host-id 7))
    (assert settings.endpoint.secure)
    (assert (= settings.endpoint.tags '[:primary]))
    (discard err))

  (let [[settings err ok]
        (data.decode
          Settings
          '{:port 8080
            :enabled true
            :ratio 0.5
            :metadata {}
            :endpoint {:host-id 7
                       :secure :sometimes
                       :tags []}}
          '[:settings])]
    (assert (not ok))
    (assert (= err.path '[:settings :endpoint :secure]))
    (assert (= err.expected .Bool))
    (assert (= err.actual .Keyword))
    (discard settings)))
