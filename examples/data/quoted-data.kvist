(package main)
(import data "kvist:data")

(def config
  '{:port 8080
    :features #{:query :pull}})

(def query
  '[:find ?name
    :where [?e :user/name ?name]])

(defn main []
  (let [port (data.int (get config :port))
        features (get config :features)
        config-keys (data.keys config) :defer]
    (println port
             (contains? features :query)
             (count query)
             (count config-keys))))
