(package tests)

(import t "kvist:test")
(import arr "kvist:arr")
(import data "kvist:data")
(import edn "kvist:edn")
(import map "kvist:map")
(import set "kvist:set")
(import str "kvist:str")
(import soa "kvist:soa")

(defstruct Profile {
  name: string
  age: int
})

(defn inc-value [x: int] -> int
  (+ x 1))

(defn query-missing [] -> [value: int, ok: bool] #optional_ok
  (return 0 false))

(defn same-data-backing? [left: Data, right: Data] -> bool #force_inline
  (odin-call "kvist_data_same_backing" left right))

(t.deftest core-package-edge-cases
  (let [xs [1 2 3] :defer
        empty-xs (arr.dynamic int []) :defer
        lookup (map.of string int {"a" 1}) :defer
        mutable ([dynamic]int [1 2 3]) :defer
        profile (Profile {name: "Ada" age: 10})
        updated-profile profile
        missing (or-else (query-missing) 9)]
    (set! mutable[0] 7)
    (set! updated-profile.age 11)
    (t.is (= (count empty-xs) 0))
    (t.is (empty? empty-xs))
    (t.is (contains? xs 2))
    (t.is (not (contains? xs 9)))
    (t.is (contains? lookup "a"))
    (t.is (not (contains? lookup "z")))
    (t.is (= (get mutable 0) 7))
    (t.is (= updated-profile.age 11))
    (t.is (= profile.age 10))
    (t.is (= missing 9))))

(t.deftest map-package-edge-cases
  (let [empty-map (map.empty string int) :defer
        base (map.of string int {"a" 1 "b" 2}) :defer
        other (map.of string int {"b" 20}) :defer
        merged (map.merge base other) :defer
        assoced (map.assoc base "c" 3) :defer
        trimmed (map.dissoc base "missing") :defer
        keys (map.keys empty-map) :defer
        vals (map.vals empty-map) :defer
        empty-keys (arr.dynamic string []) :defer
        empty-vals (arr.dynamic int []) :defer
        zipped-empty (map.zip (slice empty-keys 0) (slice empty-vals 0)) :defer
        short-keys (arr.dynamic string ["a" "b" "c"]) :defer
        short-vals (arr.dynamic int [10 20]) :defer
        zipped-short (map.zip (slice short-keys 0) (slice short-vals 0)) :defer
        mutable (map.of string int {}) :defer]
    (map.assoc! mutable "x" 1)
    (map.assoc! mutable "x" 2)
    (map.dissoc! mutable "missing")
    (map.merge! mutable other)
    (t.is (= (map.get empty-map "none" 7) 7))
    (t.is (not (map.contains? empty-map "a")))
    (t.is (= (map.get merged "b" 0) 20))
    (t.is (= (map.get assoced "c" 0) 3))
    (t.is (= (map.get trimmed "a" 0) 1))
    (t.is (= (count keys) 0))
    (t.is (= (count vals) 0))
    (t.is (= (count zipped-empty) 0))
    (t.is (= (map.get zipped-short "a" 0) 10))
    (t.is (= (map.get zipped-short "c" 99) 99))
    (t.is (= (map.get mutable "x" 0) 2))
    (t.is (= (map.get mutable "b" 0) 20))))

(t.deftest data-package-edge-cases
  (let [message: Data
        {:name "Ada"
         :active? true
         :address nil}
        unchanged-name (data.assoc message :name (:name message))
        unchanged-owned-name
        (data.assoc message :name (data.from-string "Ada"))
        missing-dissoc (data.dissoc message :missing)
        changed-name (data.assoc message :name "Grace")
        values: Data [1 2 3]
        unchanged-item (data.assoc values 1 2)
        changed-item (data.assoc values 1 4)
        [name name-present?] (data.lookup message :name)
        [address address-present?] (data.lookup message :address)
        [missing missing-present?] (data.lookup message :missing)
        ordered: Data {:a 1 :b 2}
        ordered-copy: Data {:a 1 :b 2}
        reordered: Data {:b 2 :a 1}
        ordered-set: Data #{:a :b}
        reordered-set: Data #{:b :a}
        parsed (edn.read "{:name \"Ada\" :address nil}")
        [_ duplicate-error duplicate-ok]
        (edn.try-read "{:name \"Ada\" :name \"Grace\"}")]
    (t.is (same-data-backing? message unchanged-name))
    (t.is (same-data-backing? message unchanged-owned-name))
    (t.is (same-data-backing? message missing-dissoc))
    (t.is (not (same-data-backing? message changed-name)))
    (t.is (same-data-backing? values unchanged-item))
    (t.is (not (same-data-backing? values changed-item)))
    (t.is name-present?)
    (t.is (= (data.string name) "Ada"))
    (t.is address-present?)
    (t.is (data.nil? address))
    (t.is (not missing-present?))
    (t.is (data.nil? missing))
    (for [_ (arr.range 0 100)]
      (let [[repeated-name repeated-present?] (data.lookup message :name)]
        (t.is repeated-present?)
        (t.is (= (data.string repeated-name) "Ada"))))
    (t.is (= (data.string (:name message)) "Ada"))
    (t.is (data.equal? ordered ordered-copy))
    (t.is (data.equal? ordered reordered))
    (t.is (data.equal? ordered-set reordered-set))
    (t.is (= (data.string (:name parsed)) "Ada"))
    (t.is (data.nil? (:address parsed)))
    (t.is (not duplicate-ok))
    (t.is (= duplicate-error.message "duplicate map key"))))

(t.deftest set-package-edge-cases
  (let [empty-set (set.of int []) :defer
        lhs (set.of int [1 2 3]) :defer
        rhs (set.of int [3 4]) :defer
        disjoint-rhs (set.of int [7 8]) :defer
        unioned (set.union lhs empty-set) :defer
        intersected (set.intersection lhs disjoint-rhs) :defer
        differed (set.difference lhs empty-set) :defer
        same (set.add lhs 2) :defer
        removed-missing (set.remove lhs 9) :defer
        mutable (set.of int []) :defer
        remove-four (set.of int [4]) :defer]
    (set.add! mutable 1)
    (set.add! mutable 1)
    (set.remove! mutable 9)
    (set.union! mutable rhs)
    (set.intersection! mutable rhs)
    (set.difference! mutable remove-four)
    (t.is (not (set.contains? empty-set 1)))
    (t.is (set.contains? unioned 3))
    (t.is (not (set.contains? intersected 1)))
    (t.is (not (set.contains? intersected 3)))
    (t.is (set.contains? differed 2))
    (t.is (set.contains? same 2))
    (t.is (set.contains? removed-missing 1))
    (t.is (set.subset? empty-set lhs))
    (t.is (set.superset? lhs empty-set))
    (t.is (set.disjoint? lhs disjoint-rhs))
    (t.is (not (set.disjoint? lhs rhs)))
    (t.is (set.contains? mutable 3))
    (t.is (not (set.contains? mutable 4)))))

(t.deftest str-package-edge-cases
  (let [parts (str.split "abc" ",") :defer
        empty-parts (arr.dynamic string []) :defer
        joined-empty (str.join empty-parts ",") :defer
        replaced-once (str.replace "a-a-a" "-" "_" 1) :defer
        replaced-missing (str.replace "abc" "z" "q") :defer
        replaced-equal (str.replace "abc" "a" "a") :defer
        lowered (str.lower "MiXeD") :defer
        uppered (str.upper "MiXeD") :defer
        builder (str.builder)
        unescaped (str.unescape "a\\nb\\t\\\"c") :defer
        unknown-escape (str.unescape "a\\qb") :defer]
    (defer (str.destroy! (addr builder)))
    (str.write! (addr builder) "hi")
    (str.write! (addr builder) "!")
    (t.is (= (str.count "") 0))
    (t.is (= (str.get "abc" 1) 98))
    (t.is (= (str.slice "abc" 1 1) ""))
    (t.is (= (count parts) 1))
    (t.is (= joined-empty ""))
    (t.is (= replaced-once "a_a-a"))
    (t.is (= replaced-missing "abc"))
    (t.is (= replaced-equal "abc"))
    (t.is (not (str.contains? "abc" "z")))
    (t.is (= (str.index-of "abc" "z") -1))
    (t.is (= (str.last-index-of "abc" "z") -1))
    (t.is (= (str.trim "abc") "abc"))
    (t.is (= (str.trim-prefix "core" "kvist/") "core"))
    (t.is (= (str.trim-suffix "core" ".txt") "core"))
    (t.is (str.starts-with? "abc" ""))
    (t.is (str.ends-with? "abc" ""))
    (t.is (= lowered "mixed"))
    (t.is (= uppered "MIXED"))
    (let [built (str.finish (addr builder)) :defer]
      (t.is (= built "hi!")))
    (t.is (= unescaped "a\nb\t\"c"))
    (t.is (= unknown-escape "a\\qb"))))

(t.deftest soa-package-edge-cases
  (let [fields (soa.fields 'Profile)
        types (soa.types 'Profile) :defer]
    (t.is (= (count fields) 2))
    (t.is (= (map.get types "missing" "none") "none"))
    (t.is (= (map.get types "name" "") "string"))))
